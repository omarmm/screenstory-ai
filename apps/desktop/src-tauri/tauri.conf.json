{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenstory",
  "version": "0.5.3",
  "identifier": "com.screenstory.desktop",
  "build": {
    "beforeDevCommand": "pnpm tauri:icons && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm tauri:icons && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screenstory",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Videos/Screenstory/Projects/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Turn screen recordings into clear tutorials.",
    "longDescription": "A local-first desktop application for recording workflows and creating editable tutorials.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libdbus-1-3",
          "pkexec"
        ]
      }
    }
  }
}
